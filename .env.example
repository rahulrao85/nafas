# Copy to .env (never commit .env). Everything here is optional: with nothing set, the app uses the template.

# claude | gemini | azure | offline
NAFAS_LLM=claude
NAFAS_CLAUDE_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Gemini (only if NAFAS_LLM=gemini). Vertex AI via your gcloud login (no key stored), or an AI Studio key.
NAFAS_GEMINI_VERTEX_PROJECT=
NAFAS_GEMINI_VERTEX_ACCOUNT=
NAFAS_GEMINI_LOCATION=global
NAFAS_GEMINI_API_KEY=
NAFAS_GEMINI_MODEL=gemini-3.5-flash
NAFAS_GEMINI_THINKING=LOW

# Azure OpenAI (only if NAFAS_LLM=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

PORT=5057
