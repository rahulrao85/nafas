# Copy to .env (never commit .env). Everything here is optional: with nothing set, the app uses the template.

# claude | azure | offline
NAFAS_LLM=claude
NAFAS_CLAUDE_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Azure OpenAI (only if NAFAS_LLM=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

PORT=5057
